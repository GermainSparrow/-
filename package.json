{
  "name": "document-sanitizer-restore",
  "version": "0.2.1",
  "description": "Electron initial version for document sanitization and restoration workflows.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/dev.js --build",
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 5173",
    "dev:electron": "node scripts/dev.js --electron-only",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "dist:win": "npm run lint && npm test && npm run build:renderer && electron-builder --win --x64 --publish never",
    "pack:win": "npm run build:renderer && electron-builder --win --x64 --dir",
    "lint": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "electron",
    "document",
    "sanitizer"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.local.document-sanitizer-restore",
    "productName": "文档脱敏还原软件",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "src/shared/**/*",
      "src/renderer/public/**/*",
      "dist/renderer/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/updates/document-sanitizer-restore/win/"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
