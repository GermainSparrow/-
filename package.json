{
  "name": "document-sanitizer-restore",
  "version": "0.2.0",
  "description": "Electron initial version for document sanitization and restoration workflows.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run dev:electron",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 5173",
    "dev:electron": "cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "lint": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "electron",
    "document",
    "sanitizer"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
